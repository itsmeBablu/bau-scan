        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse einen Raum mit deinem iPhone. Grundrisse und 3D-Modelle erscheinen hier."
          }
        }
      }
    },
    "Scan one room slowly. Cover the walls, floor and ceiling, then revisit visible equipment from several angles before finishing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse einen Raum langsam. Nimm Wände, Boden und Decke sowie sichtbare Geräte aus mehreren Richtungen auf."
          }
        }
      }
    },
