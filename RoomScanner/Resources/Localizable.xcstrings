      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur sichtbare Außenmaße. Dämmung kann das eigentliche Rohr verdecken. Werkstoffeinstellungen ändern die Darstellung, nicht die Aufnahmedaten."
          }
        }
      }
    },
