            "value": "Mit Gerät verknüpfen"
          }
        }
      }
    },
    "Use selected survey photos for MEP recognition or copy them to Google Photos.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze ausgewählte Aufmaßfotos zur Anlagenerkennung oder kopiere sie in Google Fotos."
          }
