    "error.roomplan.insufficient": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough of the room was captured. Walk along every wall."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Raum wurde nicht ausreichend erfasst. Gehe an jeder Wand entlang."
          }
        }
      }
    },
    "error.roomplan.invalidInput": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The captured rooms cannot be merged."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erfassten Räume lassen sich nicht zusammenfügen."
          }
        }
      }
    },
    "error.roomplan.invalidRoomLocation": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rooms do not share a frame: scan them one after another without leaving the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Räume haben kein gemeinsames Koordinatensystem. Erfasse sie nacheinander, ohne die App zu verlassen."
          }
        }
      }
    },
    "error.roomplan.lowTexture": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surfaces are too uniform: turn on the lights or move closer to the walls."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Flächen sind zu gleichmäßig. Schalte Licht ein oder gehe näher an die Wände."
          }
        }
      }
    },
    "error.roomplan.tooHot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone is too hot: let it cool down for a minute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone ist zu heiß. Lass es kurz abkühlen."
          }
        }
      }
    },
    "error.roomplan.tooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The room is too large for a single scan. Scan it in two parts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Raum ist für eine einzelne Aufnahme zu groß. Erfasse ihn in zwei Teilen."
          }
        }
      }
    },
    "error.roomplan.trackingLost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking was lost: start again and move more slowly."
