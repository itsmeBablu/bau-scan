            "value": "Weiter"
          }
        }
      }
    },
    "Get started": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Los geht’s"
          }
        }
      }
    },
    "Scan your space": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Räume erfassen"
          }
        }
      }
    },
    "Review and verify": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen und vergleichen"
          }
        }
      }
    },
    "Move slowly and include corners, floor and ceiling.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege dich langsam und erfasse Ecken, Boden und Decke."
          }
        }
      }
    },
    "Check important dimensions with a tape measure.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe wichtige Maße mit einem Maßband."
          }
        }
      }
    },
    "Keep photos and notes with the project.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre Fotos und Notizen beim Projekt auf."
          }
        }
      }
    },
    "Keep scans, designs and survey notes together.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre Aufnahmen, Entwürfe und Aufmaßnotizen gemeinsam auf."
          }
        }
      }
    },
    "A place, such as a flat or building address.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ort, zum Beispiel eine Wohnung oder Gebäudeadresse."
          }
        }
      }
    },
    "Reconnect its library to open this item. Your project reference has been kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde die zugehörige Bibliothek, um diesen Eintrag zu öffnen. Der Projektverweis bleibt erhalten."
          }
        }
      }
    },
    "This name is stored in the project index. The original scan stays unchanged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Name wird im Projektindex gespeichert. Die ursprüngliche Aufnahme bleibt unverändert."
          }
        }
      }
    },
    "Use good light. Clear access to walls and installations. Move slowly and avoid reflective surfaces.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorge für gutes Licht und freien Zugang zu Wänden und Anlagen. Bewege dich langsam und vermeide spiegelnde Flächen."
          }
        }
      }
    },
    "Device validation pending. Verify critical dimensions independently.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerätevalidierung ausstehend. Prüfe wichtige Maße unabhängig."
          }
        }
      }
    },
    "LiDAR capture is unavailable on this device. You can still open saved projects and designs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät ist keine LiDAR-Aufnahme möglich. Gespeicherte Projekte und Entwürfe kannst du weiterhin öffnen."
          }
        }
      }
    },
    "Group a building's scans, designs, photos and notes in one place.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasse Aufnahmen, Entwürfe, Fotos und Notizen eines Gebäudes zusammen."
          }
        }
      }
    },
    "Choose Whole home, Room or Utility room. Your original scan stays separate from design edits.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Gesamte Wohnung, Raum oder Technikraum. Die ursprüngliche Aufnahme bleibt von Entwurfsänderungen getrennt."
          }
        }
      }
    },
    "Check important dimensions before sharing a report. Capture-derived data is device validation pending.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe wichtige Maße, bevor du einen Bericht teilst. Die Gerätevalidierung der Aufnahmedaten steht aus."
          }
        }
      }
    },
    "House radiator surveys": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heizkörper-Aufmaß"
          }
        }
      }
    },
    "Scan each radiator body and the adjacent finished wall. Scan results are estimates; use confirmed instrument or manufacturer values where installation requires precise sizes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse jeden Heizkörper und die angrenzende fertige Wand. Die Aufnahmemaße sind Schätzwerte. Nutze geprüfte Mess- oder Herstellerwerte, wenn genaue Einbaumaße erforderlich sind."
          }
        }
      }
    },
    "Wall reference": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandbezug"
          }
        }
      }
    },
    "Not assigned": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht zugewiesen"
          }
        }
      }
    },
    "Scan radiator": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heizkörper erfassen"
          }
        }
      }
    },
    "Use a LiDAR-equipped iPhone or iPad for radiator close-up capture.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende für die Heizkörperaufnahme ein iPhone oder iPad mit LiDAR."
          }
        }
      }
    },
    "Automatically detected · equipment type unverified": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch erkannt · Gerätetyp ungeprüft"
          }
        }
      }
    },
    "Confirm this is a radiator": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Heizkörper bestätigen"
          }
        }
      }
    },
    "Edit and confirm measurements": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maße bearbeiten und bestätigen"
          }
