    "RoomPlan captures the room shell and supported objects. Pipe diameters, connections and equipment details need manual verification.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RoomPlan erfasst die Raumhülle und unterstützte Objekte. Rohrdurchmesser, Anschlüsse und Gerätedetails müssen unabhängig geprüft werden."
          }
        }
      }
    },
    "root.placeholder": {
      "extractionState": "manual",
