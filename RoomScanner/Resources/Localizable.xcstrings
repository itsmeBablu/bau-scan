            "value": "Umfang"
          }
        }
      }
    },
    "Photos use Photos/<room-name>.<number>/. Numbering restarts at 1 in each room. Same-name collisions receive a suffix; photo-index.json preserves room IDs and original numbers. Camera coordinates are not GPS. Device validation pending.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos liegen unter Photos/<Raumname>.<Nummer>/. Die Nummerierung beginnt in jedem Raum bei 1. Bei gleichen Namen wird ein Zusatz angefügt. photo-index.json enthält Raum-IDs und Originalnummern. Kamerakoordinaten sind kein GPS. Gerätevalidierung ausstehend."
          }
        }
      }
    },
