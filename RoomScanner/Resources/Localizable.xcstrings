    "Send %@ camera images?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Kamerabilder senden?"
          }
        }
      }
    },
    "Images will be sent to %@. Its configured AI provider may also process them. Depth stays on this device; returned image regions are fitted to local depth. API quota may be consumed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder werden an %@ gesendet. Auch der eingerichtete KI-Anbieter kann sie verarbeiten. Tiefendaten bleiben auf diesem Gerät. Zurückgegebene Bildbereiche werden mit lokalen Tiefendaten abgeglichen. API-Kontingent kann verbraucht werden."
          }
        }
      }
    },
