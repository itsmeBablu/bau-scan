# Server-only settings. Never place the Gemini API key in the app or commit it.
GEMINI_API_KEY=
# Choose a currently available image-understanding model with free-tier access in AI Studio.
GEMINI_MODEL=
GEMINI_FREE_PROJECT_CONFIRMED=false
# OAuth WEB/server client ID. Must match DWALK_GOOGLE_SERVER_CLIENT_ID in the app.
GOOGLE_SERVER_CLIENT_ID=
# Explicitly allowed, verified Google account emails for this prototype.
GOOGLE_ALLOWED_EMAILS=
MEP_USER_DAILY_LIMIT=10
MEP_TOTAL_DAILY_LIMIT=50
